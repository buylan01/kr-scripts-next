<?xml version="1.0" encoding="UTF-8" ?>
<config>

    <group>
        <text>
            <title>简介</title>
            <desc>Action (动作) 被点击时会启动参数选择弹窗(如果有), 在确认时运行命令</desc>
        </text>
    </group>

    <group title="基本参数">
        <action>
            <title>选择</title>
            <param name="single_short" title="单选" label="短列表">
                <option value="1">选项 1</option>
                <option value="2">选项 2</option>
            </param>
            <param  name="single_long" label="长列表" value="1">
                <option value="1">选项 1</option>
                <option value="2">选项 2</option>
                <option value="3">选项 3</option>
                <option value="4">选项 4</option>
                <option value="5">选项 5</option>
                <option value="6">选项 6</option>
                <option value="7">选项 7</option>
                <option value="8">选项 8</option>
                <option value="9">选项 9</option>
            </param>

            <!-- separator 属性设置输出用户选择的项目的分隔符号, 默认为 " ", 输出为 "A B C" -->
            <param name="multi" title="多选" multiple="multiple" separator="|">
                <option value="1">选项 1</option>
                <option value="2">选项 2</option>
                <option value="3">选项 3</option>
                <option value="4">选项 4</option>
                <option value="5">选项 5</option>
                <option value="6">选项 6</option>
                <option value="7">选项 7</option>
                <option value="8">选项 8</option>
                <option value="9">选项 9</option>
            </param>
            <set>
                echo '单选 (短列表)：' $single_short
                echo '单选 (长列表)：' $single_long
                echo '多选：' $multi
            </set>
        </action>

        <action>
            <title>文本输入</title>
            <param name="input_text" title="文本框" label="文本" value="默认文本喵" />
            <param name="input_int" label="数字" max="10" min="0" type="int" />
            <param name="input_length" label="字数限制" maxlength="3" placeholder="只能输入三个字符" />
            <set>
                echo '文本为：' $input_text
                echo '数值为：' $input_int
                echo '字数限制：' $input_length
            </set>
        </action>

        <action>
            <title>滑块输入</title>
            <param name="input_seekbar" max="10" min="1" title="数字" type="seekbar" value="6" />
            <set>
                echo '滑块数值为：' $input_seekbar
            </set>
        </action>

        <action>
            <title>布尔输入</title>
            <param name="input_bool" label="选框" type="bool" />
            <param name="input_switch" label="开关" type="switch" />
            <set>
                echo '选框数值为：' $input_bool
                echo '开关数值为：' $input_switch
            </set>
        </action>

        <action>
            <title>要求非空参数</title>
            <param name="input_text" title="文本框" required="1" />
            <set>
                echo '文本为：' $input_text
            </set>
        </action>
        <action warning="不许输入喵">
            <title>描述和警告</title>
            <desc>描述和警告将内嵌在弹窗中</desc>
            <param name="input_text" />
            <set>echo 可恶</set>
        </action>
    </group>

    <group>
        <action>
            <title>大杂烩</title>
            <desc>以全屏弹窗显示</desc>
            <param name="a" label="选框" type="bool" />
            <param name="b" label="开关" type="switch" />
            <param name="c" label="文本" />
            <param name="d" label="文本" />
            <param name="e" label="数字" type="int" />
            <param name="f" label="数字" type="int" />
            <param name="g" max="10" min="1" type="seekbar" />
            <set>echo 'O.o'</set>
        </action>
    </group>

    <group title="文件选择">
        <action>
            <title>文件选择</title>
            <param name="normal" type="file" value="test.txt" />
            <param name="file_suffix" label="后缀 (zip)" type="file" suffix="zip" />
            <param name="file_mime" label="mime 限制" type="file" mime="application/zip" />
            <set>
                echo '普通：' $normal
                echo '后缀限制：' $file_suffix
                echo 'mime 限制：' $file_mime
            </set>
        </action>
        <action>
            <title>文件夹选择</title>
            <param name="normal" type="folder" value="/sdcard" />
            <param label="可编辑" name="editable" type="folder" value="/sdcard" editable="true" />
            <set>
                echo '普通：' $normal
                echo '可编辑：' $editable
            </set>
        </action>
    </group>

    <group title="应用选择">
        <action>
            <title>应用/包名选择</title>

            <param name="app_normal" type="app" />

            <param
                name="app_limited"
                title="自定义获取命令"
                type="app"
                options-sh="pm list package -3 | cut -f2 -d ':'" />

            <param
                name="app_multiple"
                label="多选"
                value="com.krscripts.app,com.android.browser"
                separator=","
                type="app"
                multiple="multiple" />

            <param name="package_selector" label="包名选择器" type="packages" />
            <options>
                <option value="android">Android 系统</option>
                <option value="com.android.systemui">系统界面</option>
                <option value="com.krscripts.next.plus.pro">Kr Scripts Next Plus Pro</option>
            </options>

            <set>
                echo '普通应用：' $app_normal
                echo '限制应用：' $app_limited
                echo '多选应用：' $app_multiple
                echo '包名选择器：' $package_selector
            </set>
        </action>
    </group>

    <group title="颜色选择">
        <action>
            <title>颜色输入</title>
            <param name="test" label="颜色输入" type="color" />
            <set>echo '数值为：' $test</set>
        </action>
    </group>
</config>