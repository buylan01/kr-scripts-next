<config>
    <group>
        <!-- clip 标签用来制定该项 icon 的圆角大小 -->
        <action clip="30" icon="icons/icon.png">
            <title>圆角矩形</title>
        </action>
        <action clip="circle" icon="icons/icon.png">
            <title>圆形</title>
        </action>

        <!-- 也可以使用网址，但务必以 "http" 或 "https" 开头 -->
        <action icon="https://developers.google.cn/static/identity/images/g-logo.png"
            id="web_ic">
            <title>网络图标</title>
        </action>
        <action icon="?" id="web_ic_broken">
            <title>坏图标</title>
        </action>
    </group>
</config>