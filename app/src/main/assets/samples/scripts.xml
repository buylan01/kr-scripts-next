<?xml version="1.0" encoding="UTF-8" ?>
<config>
    <group title="运行命令">
        <action title="运行命令">
            <script>
                echo 开始~
                sleep 5
                exit 0
            </script>
        </action>
        <action title="带错输出">
            <script>
                echo 开始~
                sleep 1
                exit 1
            </script>
        </action>
        <action title="运行命令" desc="运行时禁止中断" interruptible="false">
            <script>
                echo 开始~
                sleep 4
                exit 0
            </script>
        </action>
        <action title="颜色指令">
            <script>
                echo -e "\033[30m黑色\033[0m \033[31m红色\033[0m \033[32m绿色\033[0m \033[33m黄色\033[0m \033[34m蓝色\033[0m \033[35m洋红\033[0m \033[36m青色\033[0m \033[37m白色\033[0m"
                echo -e "\033[90m亮黑\033[0m \033[91m亮红\033[0m \033[92m亮绿\033[0m \033[93m亮黄\033[0m \033[94m亮蓝\033[0m \033[95m亮洋红\033[0m \033[96m亮青\033[0m \033[97m亮白\033[0m"
                echo -e "\033[41m红底\033[0m \033[42m绿底\033[0m \033[44m蓝底\033[0m \033[45m洋红底\033[0m \033[101m亮红底\033[0m"
                echo -e "\033[1;31m粗体红\033[0m \033[3;32m斜体绿\033[0m \033[4;34m下划线蓝\033[0m \033[9;33m删除线黄\033[0m \033[1;4;35m粗体下划线洋红\033[0m"
                echo -e "\033[38;5;196m红色(256)\033[0m \033[38;5;46m绿色(256)\033[0m \033[38;5;21m蓝色(256)\033[0m \033[48;5;226m黄底(256)\033[0m"
                echo -e "\033[38;2;255;100;100m浅红\033[0m \033[38;2;100;255;100m浅绿\033[0m \033[38;2;100;100;255m浅蓝\033[0m"
                echo -e "\033[1;32m粗体绿\033[0m 普通文本 \033[31m红色\033[0m 结束"
            </script>
        </action>
        <action title="控制进度条">
            <script>
                echo progress:[0/100]
                echo 第一步
                sleep 1
                echo progress:[13/100]
                echo 第二步
                sleep 1
                echo progress:[66/100]
                echo 第三步
                sleep 1
                echo progress:[85/100]
                echo 最后一步
                sleep 1
                echo 好了
                echo progress:[100/100]
            </script>
        </action>
    </group>

    <resource dir="file:///android_asset/samples/bg_task" />

    <group title="在后台运行任务">
        <action shell="bg-task">
            <title>后台任务测试</title>
            <desc>后台任务点击后不显示日志界面，而是在通知栏中显示</desc>
            <set>
                echo '进度1/5'; echo "progress:[1/6]"; sleep 5;
                echo '进度2/5'; echo "progress:[2/6]"; sleep 5;
                echo '进度3/5'; echo "progress:[3/6]"; sleep 5;
                echo '进度4/5'; echo "progress:[4/6]"; sleep 5;
                echo '进度5/5'; echo "progress:[5/6]"; sleep 5;
                echo "progress:[6/6]"; echo '操作完成！'
            </set>
        </action>

        <action>
            <title>Activity 监视器</title>
            <desc>记录当前 Activity</desc>
            <set>$PAGE_WORK_DIR/bg_task/activity_monitor.sh</set>
        </action>

        <action shell="bg-task">
            <title>Activity 监视器 (后台)</title>
            <desc>记录当前 Activity, 并在后台运行</desc>
            <set>$PAGE_WORK_DIR/bg_task/activity_monitor.sh</set>
        </action>
    </group>

    <group title="Ansole 联动">
        <action title="打开命令行">
            <resource dir="samples/ansole" />
            <script>
                test_sh="$START_DIR/samples/ansole/test.sh"
                if [[ `pm list package com.romide.terminal` != "" ]]; then
                am start -a jackpal.androidterm.RUN_SCRIPT --es cmd "su -c $test_sh" --es title "PIO > Ansole" --activity-multiple-task
                else
                echo '你没有安装可用的Ansole'
                fi
            </script>
        </action>
    </group>
</config>