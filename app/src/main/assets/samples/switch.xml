<?xml version="1.0" encoding="UTF-8" ?>
<config>

    <group>
        <text>
            <title>简介</title>
            <desc>Switch (开关) 在按下后运行并将状态传给脚本，在初始化时执行一段脚本获取初始值</desc>
        </text>
    </group>

    <group title="基础用法">
        <switch>
            <title>开关</title>
            <get>pref_get switch_a</get>
            <set>
                echo 状态: $state
                pref_set switch_a $state
            </set>
        </switch>
    </group>

    <group title="拓展">
        <!--
            对于不太可能出现错误，且不需要提示信息的操作，可以添加 shell="hidden" 属性
            这样，执行set指定的脚本时，就会隐藏日志输出界面
        -->
        <switch shell="hidden">
            <title>隐藏日志</title>
            <desc>设置 shell="hidden" (不会丢失错误信息)</desc>
            <get>pref_get switch_b</get>
            <set>pref_set switch_b $state</set>
        </switch>

    </group>
</config>