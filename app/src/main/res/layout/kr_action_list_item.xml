<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kr_action_list_item"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp"
    android:paddingStart="4dp">

    <ImageView
        android:id="@id/kr_shortcut_icon"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/baseline_shortcut_24"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?colorOutlineVariant" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@id/kr_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:scaleType="centerCrop"
        android:padding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@id/kr_title"
        android:textColor="?colorOnSurface"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/kr_desc"
        app:layout_constraintEnd_toStartOf="@+id/right_side_barrier"
        app:layout_constraintStart_toEndOf="@+id/kr_icon"
        app:layout_constraintTop_toTopOf="@+id/kr_icon"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@id/kr_desc"
        style="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?colorOnSurfaceVariant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/kr_summary"
        app:layout_constraintEnd_toStartOf="@+id/right_side_barrier"
        app:layout_constraintStart_toEndOf="@+id/kr_icon"
        app:layout_constraintTop_toBottomOf="@+id/kr_title" />

    <TextView
        android:id="@id/kr_summary"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textColor="?colorOutline"
        app:layout_constraintBottom_toBottomOf="@+id/kr_icon"
        app:layout_constraintEnd_toStartOf="@+id/right_side_barrier"
        app:layout_constraintStart_toEndOf="@+id/kr_icon"
        app:layout_constraintTop_toBottomOf="@+id/kr_desc" />

    <ImageView
        android:id="@+id/kr_widget"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.8"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?colorOnSurfaceVariant" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/kr_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:padding="5dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@id/right_side_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="kr_switch, kr_widget" />

</androidx.constraintlayout.widget.ConstraintLayout>